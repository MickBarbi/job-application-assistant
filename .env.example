# --- Database ---------------------------------------------------------------
# SQLite by default. Point this at Postgres/MySQL for production if desired
# (and update prisma/schema.prisma's datasource provider accordingly).
DATABASE_URL="file:./dev.db"

# --- AI provider (OpenAI-compatible) ----------------------------------------
# AI resume/cover-letter generation talks to any OpenAI-compatible chat API.
# Required. Get an OpenAI key at https://platform.openai.com/api-keys
# (for a local model via Ollama, any non-empty value works — see below).
OPENAI_API_KEY="sk-..."

# Model used to tailor resumes. gpt-4o is a good default; gpt-4o-mini is cheaper.
OPENAI_MODEL="gpt-4o"

# Optional: override the base URL to use a proxy, Azure gateway, or a local
# model server. Ollama exposes an OpenAI-compatible API, so you can run
# generation on your own machine (or another box on your LAN) for free:
#   OPENAI_API_KEY="ollama"                       # any non-empty string
#   OPENAI_BASE_URL="http://localhost:11434/v1"   # or http://<desktop-ip>:11434/v1
#   OPENAI_MODEL="llama3.1"                        # a model you've `ollama pull`ed
# Prefer a capable model (7B+) for reliable JSON output.
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --- PDF generation ---------------------------------------------------------
# The LaTeX engine used to compile generated .tex into PDF. "tectonic" is
# recommended (self-contained). "pdflatex" and "xelatex" are also supported.
# If no engine is installed, PDF generation is disabled but .tex download works.
LATEX_ENGINE="tectonic"

# Directory where generated .tex / .pdf artifacts are written.
STORAGE_DIR="./storage"

# Optional: when set, protects all app/API routes with single-user auth.
APP_AUTH_TOKEN=
