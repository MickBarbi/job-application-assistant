# --- Database ---------------------------------------------------------------
# SQLite by default. Point this at Postgres/MySQL for production if desired
# (and update prisma/schema.prisma's datasource provider accordingly).
DATABASE_URL="file:./dev.db"

# --- OpenAI -----------------------------------------------------------------
# Required for AI-powered resume tailoring. Get a key at
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Model used to tailor resumes. gpt-4o is a good default; gpt-4o-mini is cheaper.
OPENAI_MODEL="gpt-4o"

# Optional: override the OpenAI base URL (e.g. for a proxy or Azure gateway).
# OPENAI_BASE_URL="https://api.openai.com/v1"

# --- PDF generation ---------------------------------------------------------
# The LaTeX engine used to compile generated .tex into PDF. "tectonic" is
# recommended (self-contained). "pdflatex" and "xelatex" are also supported.
# If no engine is installed, PDF generation is disabled but .tex download works.
LATEX_ENGINE="tectonic"

# Directory where generated .tex / .pdf artifacts are written.
STORAGE_DIR="./storage"

# Optional: when set, protects all app/API routes with single-user auth.
APP_AUTH_TOKEN=
